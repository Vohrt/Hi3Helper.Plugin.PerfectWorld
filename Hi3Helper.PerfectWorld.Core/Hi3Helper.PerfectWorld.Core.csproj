<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <Deterministic>true</Deterministic>
        <LangVersion>preview</LangVersion>
        <AssemblyName>PerfectWorld.Core</AssemblyName>
        <ProductName>Perfect World Core Plugin Library</ProductName>
        <Product>Collapse</Product>
        <Description>Common core functionality (Perfect World pw_sdk / PatcherSDK update mechanism) for Perfect World-published game plugins in Collapse Launcher</Description>
        <AssemblyTitle>Perfect World Core Library</AssemblyTitle>
        <Company>CollapsePlugin</Company>
        <Authors>$(Company).</Authors>
        <Copyright>Copyright 2026 $(Company)</Copyright>
        <Version>1.0.0</Version>
        <Configurations>Debug;Release;DebugNoReflection;ReleaseNoReflection</Configurations>
        <Title>Hi3Helper.PerfectWorld.Core</Title>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='DebugNoReflection'">
        <DefineConstants>$(DefineConstants);DEBUG;USELIGHTWEIGHTJSONPARSER</DefineConstants>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='ReleaseNoReflection'">
        <DefineConstants>$(DefineConstants);USELIGHTWEIGHTJSONPARSER</DefineConstants>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hi3Helper.Plugin.Core\Hi3Helper.Plugin.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Managed HDiffPatch applier for block-level incremental updates (pw_sdk uncompressed HDIFF13 diffs). -->
        <PackageReference Include="SharpHDiffPatch.Core" Version="2.3.4"/>
    </ItemGroup>

</Project>
